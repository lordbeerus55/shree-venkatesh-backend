generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessRole {
  ADMIN
  VIEWER
}

model User {
  id               Int      @id @default(autoincrement())
  mobile           String   @unique
  name             String
  username         String?  @unique
  mpinHash         String
  passwordHash     String?
  walletBalance    Decimal  @default(0) @db.Decimal(12, 2)
  fundsReserved    Decimal  @default(0) @db.Decimal(12, 2)
  tokenVersion     Int      @default(0)
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  isActive         Boolean  @default(true)
  isBanned         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bids               Bid[]
  walletTransactions WalletTransaction[]
  depositRequests    DepositRequest[]
  withdrawRequests   WithdrawRequest[]
}

model Admin {
  id            Int        @id @default(autoincrement())
  username      String     @unique
  passwordHash  String
  walletBalance Decimal    @default(0) @db.Decimal(12, 2)
  role             AccessRole @default(ADMIN)
  tokenVersion     Int        @default(0)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
}

model Market {
  id       Int     @id @default(autoincrement())
  name     String
  type     String  @default("main")
  isActive Boolean @default(true)

  schedules MarketSchedule[]
  results   Result[]
  bids      Bid[]
}

model MarketSchedule {
  id        Int     @id @default(autoincrement())
  marketId  Int
  dayOfWeek String
  openTime  String
  closeTime String
  isActive  Boolean @default(true)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
}

model GameRate {
  id         Int      @id @default(autoincrement())
  single     Int      @default(10)
  jodi       Int      @default(100)
  singlePana Int      @default(160)
  doublePana Int      @default(320)
  triplePana Int      @default(1000)
  sp         Int      @default(150)
  dp         Int      @default(300)
  tp         Int      @default(1000)
  fp         Int      @default(150)
  cp         Int      @default(150)
  halfSangam Int      @default(1200)
  fullSangam Int      @default(12000)
  updatedAt  DateTime @updatedAt
}

model Result {
  id              Int       @id @default(autoincrement())
  marketId        Int
  resultDate      DateTime  @db.Date
  openPana        String?
  openDigit       String?
  closePana       String?
  closeDigit      String?
  jodi            String?
  declaredAt      DateTime?
  isAutoGenerated Boolean   @default(false)

  market Market @relation(fields: [marketId], references: [id])
  bids   Bid[]

  @@unique([marketId, resultDate])
}

model Bid {
  id            Int      @id @default(autoincrement())
  userId        Int
  marketId      Int
  resultId      Int?
  bidDate       DateTime @db.Date
  session       String
  gameType      String
  number        String
  amount           Decimal  @db.Decimal(10, 2)
  payoutMultiplier Decimal  @db.Decimal(12, 2)
  idempotencyKey   String?
  status           String   @default("pending")
  winningAmount    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  market Market  @relation(fields: [marketId], references: [id])
  result Result? @relation(fields: [resultId], references: [id])

  @@unique([userId, idempotencyKey])
}

model WalletTransaction {
  id            Int      @id @default(autoincrement())
  userId        Int?
  type          String
  remark        String?
  beforeBalance Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)
  afterBalance  Decimal  @db.Decimal(12, 2)
  referenceType String?
  referenceId   Int?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model DepositRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  amount         Decimal   @db.Decimal(10, 2)
  paymentMethod  String?
  transactionRef String?
  proofImageUrl  String?
  idempotencyKey String?
  status         String    @default("pending")
  adminRemark    String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
}

model WithdrawRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  amount         Decimal   @db.Decimal(10, 2)
  accountHolder  String?
  accountNumber  String?
  ifscCode       String?
  upiId          String?
  idempotencyKey String?
  fundsReserved  Boolean   @default(false)
  status         String    @default("pending")
  adminRemark    String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model SliderImage {
  id          Int      @id @default(autoincrement())
  imageUrl    String
  redirectUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

model Content {
  key       String   @id
  body      String?
  updatedAt DateTime @updatedAt
}

model ManualPayment {
  id            Int      @id @default(autoincrement())
  paymentType   String?
  holderName    String?
  accountNumber String?
  ifscCode      String?
  upiId         String?
  qrImageUrl    String?
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Timing {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  openTime  String?
  closeTime String?
  updatedAt DateTime @updatedAt
}
